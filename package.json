{
  "name": "release-compare", "version": "0.1.0", "private": true,
  "description": "Local before-and-after release GIFs from paired screenshots.",
  "type": "module", "license": "MIT", "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite --host 127.0.0.1", "typecheck": "tsc --noEmit",
    "test": "vitest run", "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1", "test:e2e": "playwright test"
  },
  "dependencies": { "react": "19.3.0", "react-dom": "19.3.0", "gifenc": "1.0.3" },
  "devDependencies": {
    "@playwright/test": "1.63.0", "@types/node": "26.6.4",
    "@types/react": "19.3.0", "@types/react-dom": "19.3.0", "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2", "vite": "8.3.3", "vitest": "5.0.3"
  }
}
