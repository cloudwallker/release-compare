{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "WebWorker"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true, "esModuleInterop": true,
    "types": ["node", "vite/client"]
